{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":timezone(Asia/Tokyo)"],
  "description": "CI（型チェック・テスト・データ検証・ビルド）が通れば自動マージする",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "GitHub Actions はリリース直後でも待たずに更新する",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": null,
      "groupName": "GitHub Actions"
    },
    {
      "description": "@types は本体と分けず、まとめて 1 PR にする",
      "matchPackageNames": ["@types/**"],
      "groupName": "type definitions"
    },
    {
      "description": "React 関連は同時に上げる",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "description": "Vite 関連は同時に上げる",
      "matchPackageNames": ["vite", "@vitejs/**", "vitest"],
      "groupName": "vite"
    },
    {
      "description": "oxc（oxlint・oxlint-tsgolint・oxfmt）は同時に上げる",
      "matchPackageNames": ["oxlint", "oxlint-tsgolint", "oxfmt"],
      "groupName": "oxc"
    },
    {
      "description": "stylelint と共有設定は同時に上げる",
      "matchPackageNames": ["stylelint", "stylelint-config-standard"],
      "groupName": "stylelint"
    }
  ]
}
